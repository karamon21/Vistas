<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/box1"
        android:layout_alignParentBottom="true"
        android:layout_width="@dimen/box_size"
        android:layout_height="@dimen/box_size"
        android:background="@color/red"/>

    <RelativeLayout
        android:id="@+id/box2"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/cien"/>
    <RelativeLayout
        android:id="@+id/box3"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/fusia"/>

    <RelativeLayout
        android:id="@+id/box4"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/yellow"/>
    <RelativeLayout
        android:id="@+id/box5"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/black"/>
    <RelativeLayout
        android:id="@+id/box6"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box5"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/cien"/>

    <RelativeLayout
        android:id="@+id/box7"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box6"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/fusia"/>

    <RelativeLayout
        android:id="@+id/box8"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box7"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/fusia"/>
    <RelativeLayout
        android:id="@+id/box9"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box8"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/fusia"/>
    <RelativeLayout
        android:id="@+id/box10"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/box9"
        android:layout_width="51dp"
        android:layout_height="40dp"
        android:background="@color/fusia"/>


</RelativeLayout>